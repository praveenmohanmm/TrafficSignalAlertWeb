@page "/settings"
@inject AlertSettingsService SettingsService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Alert Settings</PageTitle>

<div class="tsa-app">

    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <div class="tsa-header">
        <h1>Alert Settings</h1>
        <p class="tsa-subtitle">Adjust thresholds and radii</p>
    </div>

    <!-- ── Live rules table ───────────────────────────────────────────── -->
    <div class="tsa-card">
        <div class="tsa-card-label">Current Rules</div>
        <table class="tsa-table">
            <thead>
                <tr>
                    <th>Speed</th>
                    <th>Alert Radius</th>
                </tr>
            </thead>
            <tbody>
                <tr class="tsa-table-muted">
                    <td>&lt; @S.MinSpeedKmh km/h</td>
                    <td>No alerts</td>
                </tr>
                <tr>
                    <td>@S.MinSpeedKmh – @S.SpeedBreak1Kmh km/h</td>
                    <td>@S.RadiusBand1M m</td>
                </tr>
                <tr>
                    <td>@S.SpeedBreak1Kmh – @S.SpeedBreak2Kmh km/h</td>
                    <td>@S.RadiusBand2M m</td>
                </tr>
                <tr>
                    <td>@S.SpeedBreak2Kmh – @S.SpeedBreak3Kmh km/h</td>
                    <td>@S.RadiusBand3M m</td>
                </tr>
                <tr>
                    <td>@S.SpeedBreak3Kmh – @S.SpeedBreak4Kmh km/h</td>
                    <td>@S.RadiusBand4M m</td>
                </tr>
                <tr>
                    <td>@S.SpeedBreak4Kmh – @S.MaxSpeedKmh km/h</td>
                    <td>@S.RadiusBand5M m</td>
                </tr>
                <tr class="tsa-table-muted">
                    <td>&gt; @S.MaxSpeedKmh km/h</td>
                    <td>No alerts</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- ── Alert Tone ───────────────────────────────────────────────────── -->
    <div class="tsa-card">
        <div class="tsa-card-label">Alert Tone</div>

        @foreach (var tone in _tones)
        {
            <div class="tsa-tone-row @(S.AlertTone == tone.Id ? "tsa-tone-row--selected" : "")"
                 @onclick="() => SelectTone(tone.Id)">
                <div class="tsa-tone-info">
                    <span class="tsa-tone-name">@tone.Name</span>
                    <span class="tsa-tone-desc">@tone.Description</span>
                </div>
                <div class="tsa-tone-actions">
                    @if (S.AlertTone == tone.Id)
                    {
                        <span class="tsa-tone-badge">✓ Active</span>
                    }
                    <button class="tsa-btn-preview" @onclick:stopPropagation="true"
                            @onclick="() => PreviewToneAsync(tone.Id)">▶ Preview</button>
                </div>
            </div>
        }
    </div>

    <!-- ── Speed thresholds ───────────────────────────────────────────── -->
    <div class="tsa-card">
        <div class="tsa-card-label">Speed Thresholds</div>

        <div class="tsa-slider-row">
            <div class="tsa-slider-label">
                <span>Min alert speed</span>
                <span class="tsa-slider-value">@S.MinSpeedKmh km/h</span>
            </div>
            <input type="range" min="5" max="25" step="1"
                   value="@S.MinSpeedKmh"
                   @oninput="e => SetAndSave(e, v => S.MinSpeedKmh = v)" />
        </div>

        <div class="tsa-slider-row">
            <div class="tsa-slider-label">
                <span>Band 1 → 2 break</span>
                <span class="tsa-slider-value">@S.SpeedBreak1Kmh km/h</span>
            </div>
            <input type="range" min="20" max="45" step="1"
                   value="@S.SpeedBreak1Kmh"
                   @oninput="e => SetAndSave(e, v => S.SpeedBreak1Kmh = v)" />
        </div>

        <div class="tsa-slider-row">
            <div class="tsa-slider-label">
                <span>Band 2 → 3 break</span>
                <span class="tsa-slider-value">@S.SpeedBreak2Kmh km/h</span>
            </div>
            <input type="range" min="30" max="55" step="1"
                   value="@S.SpeedBreak2Kmh"
                   @oninput="e => SetAndSave(e, v => S.SpeedBreak2Kmh = v)" />
        </div>

        <div class="tsa-slider-row">
            <div class="tsa-slider-label">
                <span>Band 3 → 4 break</span>
                <span class="tsa-slider-value">@S.SpeedBreak3Kmh km/h</span>
            </div>
            <input type="range" min="45" max="65" step="1"
                   value="@S.SpeedBreak3Kmh"
                   @oninput="e => SetAndSave(e, v => S.SpeedBreak3Kmh = v)" />
        </div>

        <div class="tsa-slider-row">
            <div class="tsa-slider-label">
                <span>Band 4 → 5 break</span>
                <span class="tsa-slider-value">@S.SpeedBreak4Kmh km/h</span>
            </div>
            <input type="range" min="55" max="90" step="1"
                   value="@S.SpeedBreak4Kmh"
                   @oninput="e => SetAndSave(e, v => S.SpeedBreak4Kmh = v)" />
        </div>

        <div class="tsa-slider-row">
            <div class="tsa-slider-label">
                <span>Max alert speed</span>
                <span class="tsa-slider-value">@S.MaxSpeedKmh km/h</span>
            </div>
            <input type="range" min="80" max="200" step="5"
                   value="@S.MaxSpeedKmh"
                   @oninput="e => SetAndSave(e, v => S.MaxSpeedKmh = v)" />
        </div>
    </div>

    <!-- ── Alert radii ────────────────────────────────────────────────── -->
    <div class="tsa-card">
        <div class="tsa-card-label">Alert Radii</div>

        <div class="tsa-slider-row">
            <div class="tsa-slider-label">
                <span>@S.MinSpeedKmh – @S.SpeedBreak1Kmh km/h radius</span>
                <span class="tsa-slider-value">@S.RadiusBand1M m</span>
            </div>
            <input type="range" min="10" max="200" step="5"
                   value="@S.RadiusBand1M"
                   @oninput="e => SetAndSave(e, v => S.RadiusBand1M = v)" />
        </div>

        <div class="tsa-slider-row">
            <div class="tsa-slider-label">
                <span>@S.SpeedBreak1Kmh – @S.SpeedBreak2Kmh km/h radius</span>
                <span class="tsa-slider-value">@S.RadiusBand2M m</span>
            </div>
            <input type="range" min="10" max="200" step="5"
                   value="@S.RadiusBand2M"
                   @oninput="e => SetAndSave(e, v => S.RadiusBand2M = v)" />
        </div>

        <div class="tsa-slider-row">
            <div class="tsa-slider-label">
                <span>@S.SpeedBreak2Kmh – @S.SpeedBreak3Kmh km/h radius</span>
                <span class="tsa-slider-value">@S.RadiusBand3M m</span>
            </div>
            <input type="range" min="10" max="300" step="5"
                   value="@S.RadiusBand3M"
                   @oninput="e => SetAndSave(e, v => S.RadiusBand3M = v)" />
        </div>

        <div class="tsa-slider-row">
            <div class="tsa-slider-label">
                <span>@S.SpeedBreak3Kmh – @S.SpeedBreak4Kmh km/h radius</span>
                <span class="tsa-slider-value">@S.RadiusBand4M m</span>
            </div>
            <input type="range" min="10" max="300" step="5"
                   value="@S.RadiusBand4M"
                   @oninput="e => SetAndSave(e, v => S.RadiusBand4M = v)" />
        </div>

        <div class="tsa-slider-row">
            <div class="tsa-slider-label">
                <span>@S.SpeedBreak4Kmh – @S.MaxSpeedKmh km/h radius</span>
                <span class="tsa-slider-value">@S.RadiusBand5M m</span>
            </div>
            <input type="range" min="10" max="400" step="5"
                   value="@S.RadiusBand5M"
                   @oninput="e => SetAndSave(e, v => S.RadiusBand5M = v)" />
        </div>
    </div>

    <!-- ── Actions ───────────────────────────────────────────────────── -->
    <div class="tsa-controls">
        <button class="tsa-btn tsa-btn--stop" @onclick="ResetAsync">Reset Defaults</button>
        <button class="tsa-btn tsa-btn--start" @onclick='() => Nav.NavigateTo(Nav.BaseUri)'>← Back</button>
    </div>

</div>

@code {
    private AlertSettings S => SettingsService.Settings;

    private record ToneOption(string Id, string Name, string Description);

    private readonly ToneOption[] _tones =
    [
        new("triple-beep",  "Triple Beep",  "Three sharp C6 beeps — assertive & attention-grabbing"),
        new("single-beep",  "Single Beep",  "One short C6 beep — subtle & quick"),
        new("alert-chime",  "Alert Chime",  "Descending E6 → C6 → G5 chime — pleasant & clear"),
    ];

    protected override async Task OnInitializedAsync()
        => await SettingsService.LoadAsync();

    private void SelectTone(string toneId)
    {
        S.AlertTone = toneId;
        _ = SettingsService.SaveAsync();
        StateHasChanged();
    }

    private async Task PreviewToneAsync(string toneId)
    {
        await JS.InvokeVoidAsync("trafficAudio.unlock");
        await JS.InvokeVoidAsync("trafficAudio.play", toneId);
    }

    private void SetAndSave(ChangeEventArgs e, Action<double> setter)
    {
        if (double.TryParse(e.Value?.ToString(), out var v))
        {
            setter(v);
            _ = SettingsService.SaveAsync();
            StateHasChanged();
        }
    }

    private async Task ResetAsync()
    {
        await SettingsService.ResetAsync();
        StateHasChanged();
    }
}
